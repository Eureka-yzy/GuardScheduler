#include <windows.h>
#include <commctrl.h>
#include "resource.h"

#pragma code_page(65001)

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED

IDD_LOGIN DIALOGEX 0, 0, 286, 144
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "保安排班系统 · 登录"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT           "账号登录", -1, 16, 13, 254, 13
    LTEXT           "账  号", -1, 18, 42, 47, 12
    EDITTEXT        IDC_USERNAME, 70, 39, 198, 17, ES_AUTOHSCROLL
    LTEXT           "密  码", -1, 18, 66, 47, 12
    EDITTEXT        IDC_PASSWORD, 70, 63, 198, 17, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "首次使用，请填写账号和密码后点击注册。", -1, 18, 89, 250, 14
    DEFPUSHBUTTON   "登录(&L)", IDOK, 70, 114, 62, 18
    PUSHBUTTON      "注册(&R)", IDC_REGISTER, 138, 114, 62, 18
    PUSHBUTTON      "退出", IDCANCEL, 206, 114, 62, 18
END

IDD_MAIN DIALOGEX 0, 0, 570, 329
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "保安排班系统"
FONT 9, "Microsoft YaHei UI"
BEGIN
