    CONTROL         "", IDC_USER_LABEL, "Static", SS_RIGHT | SS_ENDELLIPSIS, 262, 12, 296, 13
    PUSHBUTTON      "手动新增(&N)", IDC_MANUAL, 12, 32, 72, 18
    PUSHBUTTON      "自动排班(&G)", IDC_GENERATE, 90, 32, 72, 18
    PUSHBUTTON      "修改休息日(&E)", IDC_MODIFY, 168, 32, 78, 18
    PUSHBUTTON      "删除选中", IDC_DELETE, 252, 32, 66, 18
    PUSHBUTTON      "删除全部", IDC_DELETE_ALL, 324, 32, 66, 18
    PUSHBUTTON      "当天值班(&T)", IDC_TODAY, 410, 32, 72, 18
    PUSHBUTTON      "保安档案(&P)", IDC_GUARDS, 486, 32, 72, 18
